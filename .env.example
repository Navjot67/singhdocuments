# Stripe keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price: cents (399) or dollars (3.99). Do not use commas.
STRIPE_PRICE_CENTS=3.99

# App URL (no trailing slash)
# Local: http://localhost:8000
# Production: https://singhdocuments.com
BASE_URL=https://singhdocuments.com
PORT=8000

# Email (PDF sent after successful payment)
# Recommended on Render: Resend (HTTPS — Gmail SMTP is blocked on Render)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Singh Documents <noreply@singhdocuments.com>

# Optional local SMTP fallback (Gmail — works locally, not on Render)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASSWORD=your-gmail-app-password
# SMTP_USE_SSL=false
